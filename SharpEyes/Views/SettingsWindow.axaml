<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SharpEyes.ViewModels"
        xmlns:uc="clr-namespace:SharpEyes.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        Width="800" Height="600" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        x:Class="SharpEyes.Views.SettingsWindow"
        Title="Settings">

  <Design.DataContext>
    <vm:SettingsWindowViewModel/>
  </Design.DataContext>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="160"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!--Left sidebar: category list-->
    <ListBox Grid.Column="0" Margin="4"
             Items="{Binding Categories}"
             SelectedIndex="{Binding SelectedCategoryIndex}"/>

    <!--Right content area-->
    <Border Grid.Column="1" Margin="4" Name="ContentArea"/>

  </Grid>
</Window>
