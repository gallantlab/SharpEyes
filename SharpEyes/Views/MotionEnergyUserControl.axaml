<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             xmlns:vm="clr-namespace:SharpEyes.ViewModels"
             x:Class="SharpEyes.Views.MotionEnergyUserControl">
  <Design.DataContext>
    <vm:MotionEnergyViewModel/>
  </Design.DataContext>
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="4" ShowGridLines="False">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="350"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ShowGridLines="False" Grid.Row="0" Grid.Column="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="96"/>
      </Grid.RowDefinitions>

      <!--Top button row-->
      <StackPanel Orientation="Horizontal" Grid.Row="0">
        <Button Margin="4" Command="{Binding LoadVideoCommand}">Open Video</Button>
      </StackPanel>

      <!--Video display-->
      <Panel Grid.Row="1">
        <Viewbox Stretch="Uniform">
          <Image Source="{Binding VideoFrame}" Width="{Binding VideoWidth}" Height="{Binding VideoHeight}"/>
        </Viewbox>
      </Panel>

      <!--Video playback controls-->
      <StackPanel Orientation="Vertical" Grid.Row="2">
        <Slider Margin="0 0 4 4" Minimum="0" IsEnabled="{Binding CanPlayVideo}"
                Maximum="{Binding TotalVideoFrames}" Value="{Binding CurrentVideoFrame}"/>
        <Panel>
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding CurrentVideoTime}"/>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
            <Button ToolTip.Tip="Previous Frame" Height="32" VerticalContentAlignment="Center"
                    Command="{Binding PreviousFrameCommand}">⮜</Button>
            <Button Height="32" VerticalContentAlignment="Center" Margin="2 0 2 0"
                    Content="{Binding PlayPauseButtonText}" Command="{Binding PlayPauseCommand}"/>
            <Button ToolTip.Tip="Next Frame" Height="32" VerticalContentAlignment="Center"
                    Command="{Binding NextFrameCommand}">⮞</Button>
          </StackPanel>
          <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4 0 4 0"
                     Text="{Binding TotalVideoTime}"/>
        </Panel>
      </StackPanel>
    </Grid>

    <!--Status bar-->
    <DockPanel Grid.Row="1" Grid.Column="0" LastChildFill="True" VerticalAlignment="Center">
      <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}"/>
      <ProgressBar Margin="4 0 4 0" Minimum="0" Maximum="100"
                   Value="{Binding ProgressBarValue}" IsVisible="{Binding IsProgressBarVisible}"/>
    </DockPanel>

    <!--Side panel (empty; to be filled in a future task)-->
    <DockPanel Margin="0" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2">
      <ScrollViewer DockPanel.Dock="Top" Margin="2">
        <StackPanel/>
      </ScrollViewer>
    </DockPanel>

  </Grid>
</UserControl>
