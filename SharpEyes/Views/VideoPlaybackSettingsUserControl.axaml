<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="400"
             x:Class="SharpEyes.Views.VideoPlaybackSettingsUserControl">

    <ScrollViewer>
        <StackPanel Margin="8">
            <TextBlock Margin="0 0 0 4">Time display</TextBlock>
            <ToggleSwitch OnContent="Frame number" OffContent="Timecode"
                          IsThreeState="False"
                          IsChecked="{Binding ShowFrameNumber}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
